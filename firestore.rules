rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Membro da equipe = usuário logado cujo e-mail está nesta lista.
    // Para adicionar um funcionário: crie o usuário em Authentication
    // e inclua o e-mail dele aqui (entre aspas, separado por vírgula).
    function ehEquipe() {
      return request.auth != null &&
             request.auth.token.email in [
               "EMAIL_DO_FUNCIONARIO@exemplo.com"
             ];
    }

    match /lavagens/{id} {
      // Cliente: abre SOMENTE o documento cujo código está no link.
      // "get" lê um documento pelo ID; "list" (listar todos) fica bloqueado.
      allow get: if true;
      allow list, create, update, delete: if ehEquipe();
    }
  }
}
