rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function doc(caminho) { return /databases/$(database)/documents/$(caminho); }

    // Administrador da plataforma: tem documento em /admins/{uid}
    function admin() { return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Proprietário: o uid do estabelecimento é o uid do login do proprietário
    function donoDe(est) { return logado() && request.auth.uid == est; }

    // Funcionário com login próprio, ativo, vinculado a este estabelecimento
    function funcDe(est) {
      let m = /databases/$(database)/documents/membros/$(request.auth.uid);
      return logado() && exists(m) && get(m).data.est == est && get(m).data.ativo == true;
    }

    // Conta do estabelecimento aprovada e dentro do período pago / de teste
    function contaOk(est) {
      let c = get(/databases/$(database)/documents/contas/$(est)).data;
      return c.status == "ativo" && (!("venceEm" in c) || c.venceEm > request.time.toMillis());
    }

    // Quem pode operar o pátio deste estabelecimento
    function equipe(est) { return (donoDe(est) || funcDe(est)) && contaOk(est); }

    // Fotos do pet (Petflux): imagem já reduzida no celular, com limite de tamanho
    function fotoOk(d, campo) { return !(campo in d) || d[campo] == null || (d[campo] is string && d[campo].size() < 200000); }
    function fotosOk(d) { return fotoOk(d, "foto") && fotoOk(d, "fotoPronto"); }

    match /admins/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Dados privados da conta (e-mail, WhatsApp, status, plano)
    match /contas/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin() || funcDe(uid));
      allow list: if admin();
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.status == "pendente"
        && request.resource.data.keys().hasOnly(["email", "nome", "whatsapp", "produto", "status", "criadoEm"])
        && (!("produto" in request.resource.data) || request.resource.data.produto in ["lavaflux", "petflux"]);
      allow update, delete: if admin();
    }

    // Funcionários com login individual — só o proprietário cria, altera ou revoga
    match /membros/{uid} {
      allow get: if logado() && (request.auth.uid == uid || donoDe(resource.data.est) || admin());
      allow list: if logado() && resource.data.est == request.auth.uid;
      allow create: if donoDe(request.resource.data.est)
        && request.resource.data.keys().hasOnly(["est", "nome", "usuario", "ativo", "criadoEm", "alteradoEm"])
        && request.resource.data.ativo is bool;
      allow update: if donoDe(resource.data.est) && request.resource.data.est == resource.data.est
        && request.resource.data.usuario == resource.data.usuario;
      allow delete: if donoDe(resource.data.est);
    }

    // Configuração da plataforma (preço, Pix, link de assinatura) — usuários logados
    match /config/plataforma {
      allow get: if logado();
      allow write: if admin();
    }
    // Contato público de suporte, exibido no site
    match /config/publico {
      allow get: if true;
      allow write: if admin();
    }

    // Dados públicos do estabelecimento (nome, etapas, horário) — o cliente lê
    match /estabelecimentos/{uid} {
      allow get: if true;
      allow list: if admin();
      allow create: if admin() || donoDe(uid);
      allow update: if admin() || donoDe(uid)
        // funcionário só atualiza os contadores de uso ao registrar um veículo
        || (funcDe(uid) && contaOk(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uso"]));
      allow delete: if admin();
    }

    // Veículo — dados mínimos para o cliente acompanhar pelo link (código aleatório de 20 caracteres)
    match /lavagens/{id} {
      allow get: if true;
      allow list: if admin() || equipe(resource.data.est);
      allow create: if equipe(request.resource.data.est) && fotosOk(request.resource.data);
      allow update: if equipe(resource.data.est) && request.resource.data.est == resource.data.est && fotosOk(request.resource.data);
      allow delete: if admin() || (donoDe(resource.data.est) && contaOk(resource.data.est));

      // Dados que o cliente não vê: telefone e histórico com nomes da equipe
      match /privado/{doc} {
        allow get: if admin() || equipe(resource.data.est);
        allow list: if false;
        allow create: if equipe(request.resource.data.est)
          && getAfter(/databases/$(database)/documents/lavagens/$(id)).data.est == request.resource.data.est;
        allow update: if equipe(resource.data.est) && request.resource.data.est == resource.data.est;
        allow delete: if admin() || (donoDe(resource.data.est) && contaOk(resource.data.est));
      }
    }
    /* ================== Escalaflux (escala de plantões) — coleções próprias, separadas do Lavaflux/Petflux ================== */
    function escConta(s) { return get(/databases/$(database)/documents/esc_contas/$(s)).data; }
    function escOk(s) { let c = escConta(s); return c.status == "ativo" && (!("venceEm" in c) || c.venceEm > request.time.toMillis()); }
    function escCoord(s) { return logado() && request.auth.uid == s; }
    function escMed(s) {
      let m = /databases/$(database)/documents/esc_medicos/$(request.auth.uid);
      return logado() && exists(m) && get(m).data.servico == s && get(m).data.ativo == true;
    }
    function escMembro(s) { return (escCoord(s) || escMed(s)) && escOk(s); }

    // O que o médico pode mudar num plantão
    function escMedAltera() {
      let a = resource.data;
      let b = request.resource.data;
      let u = request.auth.uid;
      let ch = b.diff(a).affectedKeys();
      return (
        // pegar plantão vago (o primeiro que gravar fica com ele)
        (a.status == "vago" && b.status == "escalado" && b.medico == u && ch.hasOnly(["status", "medico", "medicoNome", "hist"]))
        // oferecer o próprio plantão para troca, ou cancelar a oferta
        || (a.medico == u && ch.hasOnly(["troca", "hist"])
            && (b.troca == null || (b.troca.de == u && b.troca.status == "aberta" && !("para" in b.troca))))
        // assumir um plantão oferecido por colega (fica aguardando a coordenação aprovar)
        || (a.medico != u && ("troca" in a) && a.troca != null && a.troca.status == "aberta" && ch.hasOnly(["troca", "hist"])
            && b.troca.de == a.troca.de && b.troca.para == u && b.troca.status == "aceita"));
    }

    match /esc_contas/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin() || escMed(uid));
      allow list: if admin();
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.status == "pendente"
        && request.resource.data.keys().hasOnly(["email", "nome", "whatsapp", "status", "criadoEm"]);
      allow update, delete: if admin();
    }
    match /esc_servicos/{uid} {
      allow get: if admin() || escCoord(uid) || escMed(uid);
      allow list: if admin();
      allow create, update: if admin() || escCoord(uid);
      allow delete: if admin();
    }
    match /esc_medicos/{uid} {
      allow get: if logado() && (request.auth.uid == uid || escCoord(resource.data.servico) || admin());
      allow list: if logado() && resource.data.servico == request.auth.uid;
      allow create: if escCoord(request.resource.data.servico)
        && request.resource.data.keys().hasOnly(["servico", "nome", "crm", "whatsapp", "usuario", "ativo", "criadoEm", "alteradoEm"])
        && request.resource.data.ativo is bool;
      allow update: if escCoord(resource.data.servico) && request.resource.data.servico == resource.data.servico
        && request.resource.data.usuario == resource.data.usuario;
      allow delete: if escCoord(resource.data.servico);
    }
    match /esc_plantoes/{id} {
      allow read: if admin() || escMembro(resource.data.servico);
      allow create: if escCoord(request.resource.data.servico) && escOk(request.resource.data.servico);
      allow update: if escMembro(resource.data.servico) && request.resource.data.servico == resource.data.servico
        && (escCoord(resource.data.servico) || escMedAltera());
      allow delete: if escCoord(resource.data.servico) && escOk(resource.data.servico);
    }
    // Disponibilidade: id = serviço_médico_mês; só o próprio médico grava, a coordenação lê
    match /esc_disp/{id} {
      allow get: if logado() && (resource == null || resource.data.medico == request.auth.uid
        || (escCoord(resource.data.servico) && escOk(resource.data.servico)));
      allow list: if escCoord(resource.data.servico) && escOk(resource.data.servico);
      allow create, update: if escMed(request.resource.data.servico) && escOk(request.resource.data.servico)
        && request.resource.data.medico == request.auth.uid
        && id == request.resource.data.servico + "_" + request.auth.uid + "_" + request.resource.data.mes
        && (resource == null || resource.data.medico == request.auth.uid)
        && request.resource.data.keys().hasOnly(["servico", "medico", "medicoNome", "mes", "dias", "obs", "em"])
        && request.resource.data.dias.size() <= 31;
      allow delete: if false;
    }
  }
}
